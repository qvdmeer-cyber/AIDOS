{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aidos.local/schema/review-package.schema.json",
  "title": "AIDOS Review Package Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "package_type", "review_id", "project_id", "project_root", "definition_id", "definition_version", "execution_id", "revision", "assignment_path", "review_record_path", "terminal_result_path", "validation_result_path", "events_path", "stderr_path", "git_head", "evidence_refs", "published_at"],
  "properties": {
    "schema_version": {"type": "string", "const": "0.1"},
    "package_type": {"type": "string", "const": "REVIEW_PACKAGE"},
    "review_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "project_root": {"type": "string", "minLength": 1},
    "definition_id": {"type": "string", "minLength": 1},
    "definition_version": {"type": "integer", "minimum": 1},
    "execution_id": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1},
    "assignment_path": {"type": "string", "minLength": 1},
    "review_record_path": {"type": "string", "minLength": 1},
    "terminal_result_path": {"type": "string", "minLength": 1},
    "validation_result_path": {"type": "string", "minLength": 1},
    "events_path": {"type": "string", "minLength": 1},
    "stderr_path": {"type": "string", "minLength": 1},
    "git_head": {"type": ["string", "null"]},
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "path", "sha256"],
        "properties": {
          "kind": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "published_at": {"type": "string", "format": "date-time"}
  }
}
