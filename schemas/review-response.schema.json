{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aidos.local/schema/review-response.schema.json",
  "title": "AIDOS Review Response",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "envelope_type", "review_id", "project_id", "project_root", "project_mode", "definition_id", "definition_version", "execution_id", "revision", "reviewer_role", "reviewer_identity", "assignment_sha256", "package_manifest_sha256", "outcome", "reason", "evidence_refs", "repair_guidance", "responded_at", "responded_by"],
  "properties": {
    "schema_version": {"type": "string", "const": "0.1"},
    "envelope_type": {"type": "string", "const": "REVIEW_RESPONSE"},
    "review_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "project_root": {"type": "string", "minLength": 1},
    "project_mode": {"type": "string", "enum": ["NEW_PROJECT", "EXISTING_PROJECT"]},
    "definition_id": {"type": "string", "minLength": 1},
    "definition_version": {"type": "integer", "minimum": 1},
    "execution_id": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1},
    "reviewer_role": {"type": "string", "minLength": 1},
    "reviewer_identity": {"type": "string", "minLength": 1},
    "assignment_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "package_manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "outcome": {"type": "string", "enum": ["PASS", "REPAIR", "BLOCKER", "DISCOVERY_REFRESH_REQUIRED", "WAITING_INTERACTIVE_SESSION"]},
    "reason": {"type": "string"},
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "path", "sha256"],
        "properties": {
          "kind": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "repair_guidance": {"type": "array", "items": {"type": "string"}},
    "responded_at": {"type": "string", "format": "date-time"},
    "responded_by": {"type": "string", "minLength": 1}
  }
}
