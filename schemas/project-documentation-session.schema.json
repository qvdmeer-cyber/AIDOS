{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aidos.local/schema/project-documentation-session.schema.json",
  "title": "AIDOS Project Documentation Session",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "mode", "state", "questions", "accepted_answers"],
  "properties": {
    "schema_version": {"type": "string", "const": "0.1"},
    "project_id": {"type": "string", "minLength": 1},
    "mode": {"enum": ["NEW_PROJECT", "EXISTING_PROJECT", "REFRESH"]},
    "state": {"enum": ["INVENTORY", "GAP_ANALYSIS", "INTERVIEW", "PROPOSED_BASELINE", "ACCEPTED", "PAUSED"]},
    "started_at": {"type": ["string", "null"], "format": "date-time"},
    "last_updated_at": {"type": ["string", "null"], "format": "date-time"},
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "concern", "prompt", "status"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "concern": {"type": "string", "minLength": 1},
          "prompt": {"type": "string", "minLength": 1},
          "options": {"type": "array", "items": {"type": "string"}},
          "status": {"enum": ["OPEN", "ANSWERED", "SUPERSEDED", "NOT_NEEDED"]}
        }
      }
    },
    "accepted_answers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question_id", "answer", "accepted_by_human"],
        "properties": {
          "question_id": {"type": "string", "minLength": 1},
          "answer": {"type": "string"},
          "accepted_by_human": {"type": "boolean", "const": true},
          "target_source": {"type": ["string", "null"]}
        }
      }
    },
    "pending_conflicts": {"type": "array", "items": {"type": "string"}},
    "notes": {"type": "array", "items": {"type": "string"}}
  }
}
