{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aidos.local/schema/profile-preset.schema.json",
  "title": "AIDOS Profile Preset",
  "type": "object",
  "additionalProperties": false,
  "required": ["preset_id","version","category","label","description","maturity","applicability_rules","defaults","knowledge_tags","validator_refs","execution_guidance_refs"],
  "properties": {
    "preset_id": {"type":"string","pattern":"^[A-Z0-9_]+$"},
    "version": {"type":"integer","minimum":1},
    "category": {"type":"string","enum":["PRODUCT_ARCHETYPE","CAPABILITY","INTEGRATION","STACK","INFRASTRUCTURE","EXPOSURE_RISK"]},
    "label": {"type":"string","minLength":1},
    "description": {"type":"string","minLength":1},
    "maturity": {"type":"string","enum":["CANDIDATE","PROVEN","DEPRECATED"]},
    "applicability_rules": {
      "type":"array",
      "items": {
        "type":"object",
        "additionalProperties": false,
        "required":["surface_id","state","reason"],
        "properties": {
          "surface_id":{"type":"string","minLength":1},
          "state":{"type":"string","enum":["APPLICABLE","CONDITIONAL","NOT_APPLICABLE"]},
          "reason":{"type":"string","minLength":1}
        }
      }
    },
    "defaults": {
      "type":"array",
      "items": {
        "type":"object",
        "additionalProperties": false,
        "required":["key","value","confidence","rationale"],
        "properties": {
          "key":{"type":"string","minLength":1},
          "value":{},
          "confidence":{"type":"string","enum":["SUGGESTED","EVIDENCE_BACKED"]},
          "rationale":{"type":"string","minLength":1}
        }
      }
    },
    "knowledge_tags":{"type":"array","items":{"type":"string"}},
    "validator_refs":{"type":"array","items":{"type":"string"}},
    "execution_guidance_refs":{"type":"array","items":{"type":"string"}}
  }
}
