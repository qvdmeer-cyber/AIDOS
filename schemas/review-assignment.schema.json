{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aidos.local/schema/review-assignment.schema.json",
  "title": "AIDOS Review Assignment",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "envelope_type", "review_id", "project_id", "project_root", "project_mode", "definition_id", "definition_version", "execution_id", "revision", "package_path", "package_manifest_path", "package_manifest_sha256", "review_record_path", "reviewer_role", "reviewer_identity", "allowed_outcomes", "instructions", "evidence_refs", "issued_at", "issued_by"],
  "properties": {
    "schema_version": {"type": "string", "const": "0.1"},
    "envelope_type": {"type": "string", "const": "REVIEW_ASSIGNMENT"},
    "review_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "project_root": {"type": "string", "minLength": 1},
    "project_mode": {"type": "string", "enum": ["NEW_PROJECT", "EXISTING_PROJECT"]},
    "definition_id": {"type": "string", "minLength": 1},
    "definition_version": {"type": "integer", "minimum": 1},
    "execution_id": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1},
    "package_path": {"type": "string", "minLength": 1},
    "package_manifest_path": {"type": "string", "minLength": 1},
    "package_manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "review_record_path": {"type": "string", "minLength": 1},
    "reviewer_role": {"type": "string", "minLength": 1},
    "reviewer_identity": {"type": "string", "minLength": 1},
    "allowed_outcomes": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "enum": ["PASS", "REPAIR", "BLOCKER", "DISCOVERY_REFRESH_REQUIRED", "WAITING_INTERACTIVE_SESSION"]}
    },
    "instructions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["may_inspect", "may_not", "must_return"],
      "properties": {
        "may_inspect": {"type": "array", "items": {"type": "string"}},
        "may_not": {"type": "array", "items": {"type": "string"}},
        "must_return": {"type": "array", "items": {"type": "string"}}
      }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "path", "sha256"],
        "properties": {
          "kind": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "issued_at": {"type": "string", "format": "date-time"},
    "issued_by": {"type": "string", "minLength": 1}
  }
}
