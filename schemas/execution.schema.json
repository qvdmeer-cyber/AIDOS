{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aidos.local/schema/execution.schema.json",
  "title": "AIDOS Execution",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "execution_id", "revision", "project_id", "project_mode", "preparation", "definition", "goal", "scope", "acceptance", "authority", "knowledge_selection", "executor_profile", "validation"],
  "properties": {
    "schema_version": {"type": "string", "const": "0.1"},
    "execution_id": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1},
    "project_id": {"type": "string", "minLength": 1},
    "project_mode": {"type": "string", "enum": ["NEW_PROJECT", "EXISTING_PROJECT"]},
    "workstream": {
      "oneOf": [
        {"type":"null"},
        {
          "type":"object","additionalProperties":false,
          "required":["workstream_id","shared_contract_refs","resource_lease_ids","integration_gate_refs"],
          "properties": {
            "workstream_id":{"type":"string","minLength":1},
            "shared_contract_refs":{"type":"array","items":{"type":"string"}},
            "resource_lease_ids":{"type":"array","items":{"type":"string"}},
            "integration_gate_refs":{"type":"array","items":{"type":"string"}}
          }
        }
      ]
    },
    "preparation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline_commit", "access_sha256", "evidence_inventory_sha256"],
      "properties": {
        "baseline_commit": {"type": "string", "minLength": 7},
        "access_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "evidence_inventory_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "current_product_state_id": {"type": ["string", "null"]},
        "current_product_state_commit": {"type": ["string", "null"]},
        "current_product_state_contract_version": {"type": ["string", "null"]},
        "discovery_catalog_version": {"type": ["string", "null"]}
      }
    },
    "definition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {"id": {"type": "string", "minLength": 1}, "version": {"type": "integer", "minimum": 1}}
    },
    "goal": {"type": "string", "minLength": 1},
    "scope": {"type": "object"},
    "acceptance": {"type": "array", "items": {"type": "object"}, "minItems": 1},
    "authority": {"type": "object"},
    "knowledge_selection": {"type": "array", "items": {"type": "string"}},
    "validators": {"type": "array", "items": {"type": "string"}},
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "requirements"],
      "properties": {
        "mode": {"type": "string", "const": "ALL"},
        "requirements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "path"],
            "properties": {
              "type": {"type": "string", "enum": ["PATH_EXISTS", "FILE_CONTENT_EXACT"]},
              "path": {"type": "string", "minLength": 1},
              "expected": {"type": "string"},
              "trim_trailing_newline": {"type": "boolean"}
            },
            "allOf": [{"if": {"properties": {"type": {"const": "FILE_CONTENT_EXACT"}}}, "then": {"required": ["expected"]}}]
          }
        }
      }
    },
    "executor_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "reasoning_effort"],
      "properties": {
        "model": {"type": "string", "minLength": 1},
        "reasoning_effort": {"type": "string", "minLength": 1}
      }
    },
    "stop_conditions": {"type": "array", "items": {"type": "string"}}
  },
  "allOf": [
    {
      "if": {"properties": {"project_mode": {"const": "EXISTING_PROJECT"}}},
      "then": {
        "properties": {
          "preparation": {
            "required": ["baseline_commit", "current_product_state_id", "current_product_state_commit", "current_product_state_contract_version", "discovery_catalog_version"],
            "properties": {
              "current_product_state_id": {"type": "string", "minLength": 1},
              "current_product_state_commit": {"type": "string", "minLength": 7},
              "current_product_state_contract_version": {"type": "string", "const": "0.2.0"},
              "discovery_catalog_version": {"type": "string", "const": "0.2.0"}
            }
          }
        }
      }
    }
  ]
}
