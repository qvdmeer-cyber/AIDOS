{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aidos.local/schema/definition-applicability.schema.json",
  "title": "AIDOS Definition Applicability",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","project_id","definition_id","definition_version","project_applicability_ref","core_surfaces","development_surfaces","unresolved_count","updated_at"],
  "properties": {
    "schema_version":{"type":"string","const":"0.1"},
    "project_id":{"type":"string","minLength":1},
    "definition_id":{"type":"string","minLength":1},
    "definition_version":{"type":"integer","minimum":1},
    "project_applicability_ref":{"type":"string","minLength":1},
    "core_surfaces":{
      "type":"array","minItems":6,"maxItems":6,
      "items":{"type":"string","enum":["goal_scope","current_state_delta","functional_behavior","acceptance_coverage","out_of_scope","unresolved_assumptions"]},
      "uniqueItems":true
    },
    "development_surfaces":{
      "type":"array","minItems":1,
      "items":{
        "type":"object","additionalProperties":false,
        "required":["surface_id","project_state","definition_state","reason","source_refs"],
        "properties":{
          "surface_id":{"type":"string","minLength":1},
          "project_state":{"type":"string","enum":["APPLICABLE","CONDITIONAL","NOT_APPLICABLE","UNRESOLVED"]},
          "definition_state":{"type":"string","enum":["AFFECTED","NOT_AFFECTED","NOT_APPLICABLE","DECISION_REQUIRED"]},
          "reason":{"type":["string","null"]},
          "source_refs":{"type":"array","items":{"type":"string"}}
        }
      }
    },
    "unresolved_count":{"type":"integer","minimum":0},
    "updated_at":{"type":"string","format":"date-time"}
  }
}
