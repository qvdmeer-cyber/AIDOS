{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aidos.local/schema/operator-snapshot.schema.json",
  "title": "AIDOS Operator Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","generated_at","project_root","runtime","control","host_agent","recent_events"],
  "properties": {
    "schema_version": {"type":"string","const":"0.1"},
    "generated_at": {"type":"string","format":"date-time"},
    "project_root": {"type":"string","minLength":1},
    "runtime": {"$ref":"runtime-status.schema.json"},
    "control": {
      "type":"object",
      "additionalProperties": false,
      "required":["schema_version","mode","requested_by","control_id","updated_at"],
      "properties": {
        "schema_version":{"type":"string","const":"0.1"},
        "mode":{"type":"string","enum":["RUNNING","PAUSED","SAFE_STOPPED"]},
        "requested_by":{"type":"string","minLength":1},
        "control_id":{"type":["string","null"]},
        "updated_at":{"type":["string","null"],"format":"date-time"}
      }
    },
    "host_agent": {"type":["object","null"]},
    "recent_events": {"type":"array","items":{"type":"object"}}
  }
}
