{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aidos.local/schema/human-input-request.schema.json",
  "title": "AIDOS Human Input Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","request_id","project_id","workstream_id","request_type","status","context_summary","question","options","binding","requested_by_actor","resume_actor_role","response","evidence_refs","created_at","updated_at"],
  "properties": {
    "schema_version":{"type":"string","const":"0.1"},
    "request_id":{"type":"string","minLength":1},
    "project_id":{"type":"string","minLength":1},
    "workstream_id":{"type":["string","null"]},
    "request_type":{"type":"string","enum":["PRODUCT_DECISION","AUTHORITY","RISK","RECOVERY","CLARIFICATION","DISCOVERY_AUTHORITY","RELEASE_DECISION","OTHER"]},
    "status":{"type":"string","enum":["WAITING","RESOLVED","CANCELLED","SUPERSEDED"]},
    "context_summary":{"type":"string","minLength":1},
    "question":{"type":"string","minLength":1},
    "options":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["option_id","label","description"],"properties":{"option_id":{"type":"string","minLength":1},"label":{"type":"string","minLength":1},"description":{"type":["string","null"]}}}},
    "binding":{"type":"object","additionalProperties":false,"required":["definition_id","definition_version","execution_id","revision","review_id"],"properties":{"definition_id":{"type":["string","null"]},"definition_version":{"type":["integer","null"],"minimum":1},"execution_id":{"type":["string","null"]},"revision":{"type":["integer","null"],"minimum":1},"review_id":{"type":["string","null"]}}},
    "requested_by_actor":{"type":"string","enum":["DEFINITION_AGENT","WORKER_AGENT","EXECUTION_AGENT","BRIDGE","SYSTEM"]},
    "resume_actor_role":{"type":"string","enum":["THINKER","WORKER","SYSTEM"]},
    "response":{"oneOf":[{"type":"null"},{"type":"object","additionalProperties":false,"required":["responded_by","responded_at","selected_option_id","text"],"properties":{"responded_by":{"type":"string","minLength":1},"responded_at":{"type":"string","format":"date-time"},"selected_option_id":{"type":["string","null"]},"text":{"type":["string","null"]}}}]},
    "evidence_refs":{"type":"array","items":{"type":"string"}},
    "created_at":{"type":"string","format":"date-time"},
    "updated_at":{"type":"string","format":"date-time"}
  }
}
