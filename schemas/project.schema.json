{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aidos.local/schema/project.schema.json",
  "title": "AIDOS Project Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "project_mode", "repository", "official_root", "canonical_sources", "agent_profile", "project_baseline", "project_access", "evidence_inventory", "contracts_repository"],
  "properties": {
    "schema_version": {"type": "string", "const": "0.1"},
    "project_id": {"type": "string", "minLength": 1},
    "project_mode": {"type": "string", "enum": ["NEW_PROJECT", "EXISTING_PROJECT"]},
    "repository": {"type": "string", "minLength": 1},
    "official_root": {"type": "string", "minLength": 3},
    "default_branch": {"type": "string"},
    "canonical_sources": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "agent_profile": {"type": "string", "minLength": 1},
    "project_baseline": {"type": "string", "minLength": 1},
    "project_access": {"type": "string", "minLength": 1},
    "evidence_inventory": {"type": "string", "minLength": 1},
    "current_product_state": {"type": ["string", "null"]},
    "discovery_state": {"type": ["string", "null"]},
    "discovery_authority": {"type": ["string", "null"]},
    "project_applicability": {"type": ["string", "null"]},
    "profile_preset_catalog": {"type": ["string", "null"]},
    "contracts_repository": {"type": "string", "minLength": 1},
    "capabilities": {"type": "array", "items": {"type": "string"}},
    "project_validators": {"type": "array", "items": {"type": "string"}},
    "runner_policy": {"type": "string"},
    "git_runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "project_root", "git_path"],
      "properties": {
        "kind": {"type": "string", "enum": ["NATIVE", "WINDOWS_WSL"]},
        "distribution": {"type": "string"},
        "project_root": {"type": "string", "minLength": 1},
        "git_path": {"type": "string", "minLength": 1}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"project_mode": {"const": "EXISTING_PROJECT"}}},
      "then": {
        "required": ["current_product_state", "discovery_state", "discovery_authority"],
        "properties": {
          "current_product_state": {"type": "string", "minLength": 1},
          "discovery_state": {"type": "string", "minLength": 1},
          "discovery_authority": {"type": "string", "minLength": 1}
        }
      }
    }
  ]
}
