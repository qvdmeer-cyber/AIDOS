{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aidos.local/schema/definition-progress.schema.json",
  "title": "AIDOS Definition Progress",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","catalog_version","project_id","definition_id","definition_version","status","surfaces","complete_count","incomplete_count","next_surface","updated_at"],
  "properties": {
    "schema_version": {"type":"string","const":"0.1"},
    "catalog_version": {"type":"string","const":"0.1.0"},
    "project_id": {"type":"string","minLength":1},
    "definition_id": {"type":"string","minLength":1},
    "definition_version": {"type":"integer","minimum":1},
    "status": {"type":"string","enum":["IN_PROGRESS","READY_FOR_REVIEW","ACCEPTED","REOPENED"]},
    "surfaces": {"type":"array","minItems":13,"maxItems":13,"items":{"$ref":"#/$defs/surface"}},
    "complete_count": {"type":"integer","minimum":0,"maximum":13},
    "incomplete_count": {"type":"integer","minimum":0,"maximum":13},
    "next_surface": {"type":["string","null"]},
    "last_decision_id": {"type":["string","null"]},
    "last_decision_kind": {"type":["string","null"],"enum":["HUMAN","AUTO","SYSTEM","REPO_VERIFIED",null]},
    "last_decision_at": {"type":["string","null"],"format":"date-time"},
    "last_human_decision_id": {"type":["string","null"]},
    "last_human_decision_at": {"type":["string","null"],"format":"date-time"},
    "last_auto_decision_id": {"type":["string","null"]},
    "last_auto_decision_at": {"type":["string","null"],"format":"date-time"},
    "updated_at": {"type":"string","format":"date-time"}
  },
  "$defs": {
    "surface": {
      "type":"object","additionalProperties": false,
      "required":["surface_id","status","summary","decision_refs","source_refs","open_question_count","updated_at"],
      "properties": {
        "surface_id":{"type":"string","minLength":1},
        "status":{"type":"string","enum":["COMPLETE","NOT_APPLICABLE","INCOMPLETE","DECISION_REQUIRED","BLOCKED"]},
        "summary":{"type":"string"},
        "decision_refs":{"type":"array","items":{"type":"string"}},
        "source_refs":{"type":"array","items":{"type":"string"}},
        "open_question_count":{"type":"integer","minimum":0},
        "updated_at":{"type":"string","format":"date-time"}
      }
    }
  }
}
