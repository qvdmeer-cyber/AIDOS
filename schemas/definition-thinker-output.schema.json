{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aidos.local/schemas/definition-thinker-output/0.1",
  "title": "AIDOS Definition Thinker Output",
  "type": "object",
  "additionalProperties": false,
  "required": ["result_type","summary","applicability_resolutions","surface_resolutions","human_input_request"],
  "properties": {
    "result_type": {"const":"DEFINITION_THINKER_OUTPUT"},
    "summary": {"type":"string"},
    "applicability_resolutions": {
      "type":"array",
      "items": {
        "type":"object","additionalProperties":false,
        "required":["surface_id","definition_state","authority_classification","reason","source_refs"],
        "properties": {
          "surface_id":{"type":"string","minLength":1},
          "definition_state":{"enum":["AFFECTED","NOT_AFFECTED"]},
          "authority_classification":{"enum":["SYSTEM_INVARIANT","REPO_VERIFIABLE"]},
          "reason":{"type":"string","minLength":1},
          "source_refs":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}}
        }
      }
    },
    "surface_resolutions": {
      "type":"array",
      "items": {
        "type":"object","additionalProperties":false,
        "required":["surface_id","authority_classification","status","summary","source_refs","open_question_count","auto_decision"],
        "properties": {
          "surface_id":{"type":"string","minLength":1},
          "authority_classification":{"enum":["SYSTEM_INVARIANT","REPO_VERIFIABLE","AUTO_DECIDABLE","HUMAN_REQUIRED"]},
          "status":{"enum":["COMPLETE","NOT_APPLICABLE","DECISION_REQUIRED","BLOCKED"]},
          "summary":{"type":"string","minLength":1},
          "source_refs":{"type":"array","items":{"type":"string","minLength":1}},
          "open_question_count":{"type":"integer","minimum":0},
          "auto_decision": {
            "oneOf": [
              {"type":"null"},
              {"type":"object","additionalProperties":false,"required":["chosen_value","alternatives_considered","rationale","assessment"],"properties":{
                "chosen_value":{},
                "alternatives_considered":{"type":"array"},
                "rationale":{"type":"string","minLength":1},
                "assessment":{"type":"object"}
              }}
            ]
          }
        }
      }
    },
    "human_input_request": {
      "oneOf": [
        {"type":"null"},
        {"type":"object","additionalProperties":false,"required":["surface_id","request_type","context_summary","question","options","authority_classification","auto_define_stop_reason","decision_assessment_ref","evidence_refs","source_refs"],"properties":{
          "surface_id":{"type":"string","minLength":1},
          "request_type":{"enum":["PRODUCT_DECISION","BUSINESS_DECISION","AUTHORITY","RISK","CLARIFICATION","OTHER"]},
          "context_summary":{"type":"string","minLength":1},
          "question":{"type":"string","minLength":1},
          "options":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["option_id","label","description"],"properties":{"option_id":{"type":"string","minLength":1},"label":{"type":"string","minLength":1},"description":{"type":["string","null"]}}}},
          "authority_classification":{"enum":["HUMAN_REQUIRED","AUTO_DECIDABLE"]},
          "auto_define_stop_reason":{"type":"string","minLength":1},
          "decision_assessment_ref":{"type":["string","null"]},
          "evidence_refs":{"type":"array","items":{"type":"string"}},
          "source_refs":{"type":"array","items":{"type":"string"}}
        }}
      ]
    }
  }
}
