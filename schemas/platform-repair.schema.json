{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AIDOS Platform Repair",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "repair_id", "blocker_id", "status", "classification", "component", "repository", "allowed_paths", "evidence_refs", "attempt", "max_attempts"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "repair_id": {"type": "string", "minLength": 1},
    "blocker_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["DETECTED", "ASSIGNED", "PATCHED", "VALIDATED", "SELF_UPDATED", "RETRY_PENDING", "RESOLVED", "BLOCKED"]},
    "classification": {"enum": ["PLATFORM_TRANSPORT", "PLATFORM_RUNTIME", "PLATFORM_INTERFACE", "HUMAN_REQUIRED"]},
    "component": {"type": "string", "minLength": 1},
    "repository": {"enum": ["AIDOS", "AIDOS-interface"]},
    "allowed_paths": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "attempt": {"type": "integer", "minimum": 0},
    "max_attempts": {"type": "integer", "minimum": 1},
    "last_error": {"type": ["string", "null"]},
    "created_at": {"type": "string", "minLength": 1},
    "updated_at": {"type": "string", "minLength": 1}
  }
}
